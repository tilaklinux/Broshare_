# ============================================
# HostelBarter Backend Configuration
# Copy this file to .env and update the values
# ============================================

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=broshare
DB_PORT=3306

JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=5000

# Public address of the React site (used for password reset links)
FRONTEND_URL=http://localhost:3000

# Optional free email sending for password resets (example: Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=Broshare <your_email@gmail.com>

# LOCAL DEVELOPMENT ONLY: when true and SMTP is not configured, the reset
# link is shown on the forgot-password page instead of only in the backend
# terminal. Never enable this on a public server.
ALLOW_DEV_RESET_LINK=false
